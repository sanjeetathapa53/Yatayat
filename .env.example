# Yatayat local development environment variables
#
# This file is documentation only. Spring Boot and Vite do not automatically
# load this root-level file. Copy the variable names into your IntelliJ Spring
# Boot run configuration, or set them in the terminal before starting the app.
# In PowerShell, set a variable for the current terminal with:
#   $env:DB_USERNAME = "root"

DB_URL=jdbc:mysql://localhost:3306/yatayat_db
DB_USERNAME=root
DB_PASSWORD=replace_with_local_database_password

MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_app_password

GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password
